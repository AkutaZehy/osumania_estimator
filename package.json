{
  "name": "osumania-estimator",
  "version": "4.1.0",
  "description": "osu!mania 4K key analysis and difficulty estimation plugin for tosu",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node esbuild.config.mjs",
    "dev": "node esbuild.config.mjs --watch",
    "typecheck": "tsc --noEmit",
    "bench": "esbuild scripts/bench.ts --bundle --platform=node --format=esm --outfile=dist/bench.mjs && node dist/bench.mjs",
    "bench:stages": "npm run bench -- --stages",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "esbuild": "^0.25.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}
